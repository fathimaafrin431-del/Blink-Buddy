{
  "name": "blink-popper",
  "version": "1.0.0",
  "description": "Blink 20 times to trigger a fullscreen celebration explosion.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.blinkpopper",
    "productName": "Blink Popper",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1"
  }
}
